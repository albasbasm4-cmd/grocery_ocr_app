# =====================================================================
# متجر بقالة POS - ملف متغيرات البيئة التوضيحي (.env.example)
# انسخ هذا الملف إلى .env.local وضع القيم الخاصة بك
# =====================================================================

# رابط مفتاح Supabase للواجهة الأمامية (Anon Key فقط)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# إعدادات التطبيق الافتراضية
VITE_APP_NAME="بقالة POS"
VITE_DEFAULT_CURRENCY_CODE=SAR
VITE_DEFAULT_CURRENCY_SYMBOL=ر.س

# =====================================================================
# تنبيه أمني إلزامي (Security Rules):
# =====================================================================
# 1. لا تضع أي مفتاح سري في كود الواجهة أو في هذا الملف إطلاقاً.
# 2. SUPABASE_SERVICE_ROLE_KEY يُستخدم فقط داخل بيئات مؤمنة (Supabase Edge Functions).
# 3. مفاتيح الذكاء الاصطناعي (Groq / Gemini) تُحفظ حصراً في:
#    - Supabase Secrets (للـ Edge Functions)
#    - GitHub Secrets (لأتمتة CI/CD)
# =====================================================================
